    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>React Component (TS)</Title>
            <Shortcut>§rtcomponent</Shortcut>
            <Description>Créer un composant React TS</Description>
            <Author>Converted</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID>ComponentName</ID>
                    <ToolTip>Nom du composant (PascalCase)</ToolTip>
                    <Default>MyComponent</Default>
                </Literal>
                <Literal>
                    <ID>Wrapper</ID>
                    <ToolTip>Balise wrapper</ToolTip>
                    <Default>div</Default>
                </Literal>
                <Literal>
                    <ID>PropsType</ID>
                    <ToolTip>Type de props</ToolTip>
                    <Default>ComponentProps</Default>
                </Literal>
            </Declarations>
            <Code Language="TypeScript"><![CDATA[// Functionnal component : $ComponentName$.tsx
import "./$ComponentName$.scss";

type $ComponentName$Props = $PropsType$ {
    //$end$
};

export default function $ComponentName$(props: Readonly<$ComponentName$Props>): JSX.Element {
    return (
        <$Wrapper$ className="$ComponentName$">
            $end$
        </$Wrapper$>
    );
}]]></Code>
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>useState (React TS)</Title>
            <Shortcut>§rtusestate</Shortcut>
            <Description>Créer un useState React TS</Description>
            <Author>Converted</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID>state</ID>
                    <ToolTip>Nom du state (camelCase)</ToolTip>
                    <Default>value</Default>
                </Literal>
            </Declarations>
            <Code Language="TypeScript"><![CDATA[const [$state$, set$state$] = useState($end$);]]></Code>
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>useEffect (React TS)</Title>
            <Shortcut>§rtuseeffect</Shortcut>
            <Description>Créer un useEffect React TS</Description>
            <Author>Converted</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="TypeScript"><![CDATA[useEffect(() => {
    $1

    return () => {
        $2
    };
}, [$end]);]]></Code>
        </Snippet>
    </CodeSnippet>

    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>useRef (React TS)</Title>
            <Shortcut>§rtuseref</Shortcut>
