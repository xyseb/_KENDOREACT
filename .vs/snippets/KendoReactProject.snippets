    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>lambda</Title>
            <Shortcut>§lx</Shortcut>
            <Description>lambda</Description>
            <Author>Converted</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Declarations>
                <Literal>
                    <ID>arg</ID>
                    <ToolTip>Argument</ToolTip>
                    <Default>$1</Default>
